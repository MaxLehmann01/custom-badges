<div class="h-full flex-shrink-0 py-8">
    <nav class="h-full w-64 flex flex-col bg-white text-slate-900 shadow-xl rounded-r-3xl border border-slate-200">
        <div class="w-full p-2 pl-0 border-b border-slate-100 flex">
            <a href="/" class="w-full text-2xl font-semibold text-center rounded-r-2xl bg-slate-50 border border-l-0 border-slate-200 shadow-sm px-3 py-1.5 text-slate-900 hover:bg-slate-100 hover:text-slate-700 hover:border-slate-300 focus-visible:outline-none">
                Custom-Badges
            </a>
        </div>
        <div class="flex-1 overflow-y-auto p-4">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">Projects</h2>
            <% if(projects && projects.length > 0) { %>
                <ul class="space-y-1.5">
                    <% projects.forEach((project) => { %>
                        <li>
                            <a href="/<%= encodeURIComponent(project.id); %>"
                               class="flex items-center gap-2 rounded-2xl border border-transparent px-4 py-2.5 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-slate-50 hover:text-slate-900 hover:border-slate-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-300">
                                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                                <span class="truncate"><%= project.name; %></span>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p class="text-sm text-slate-400">No projects found.</p>
            <% }%>
        </div>
    </nav>
</div>